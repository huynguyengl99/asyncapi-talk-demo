{
  "asyncapi": "3.0.0",
  "channels": {
    "room_chat": {
      "address": "/ws/room/{room_name}",
      "description": "Chat with everyone in one room",
      "messages": {
        "ping_message": {
          "$ref": "#/components/messages/ping_message"
        },
        "pong_message": {
          "$ref": "#/components/messages/pong_message"
        },
        "room_chat_message": {
          "$ref": "#/components/messages/room_chat_message"
        },
        "room_notification_message": {
          "$ref": "#/components/messages/room_notification_message"
        }
      },
      "parameters": {
        "room_name": {
          "description": "Path parameter for room_name (str)"
        }
      },
      "tags": [
        {
          "name": "chat"
        }
      ],
      "title": "room_chat"
    }
  },
  "components": {
    "messages": {
      "ping_message": {
        "payload": {
          "$ref": "#/components/schemas/PingMessage"
        }
      },
      "pong_message": {
        "payload": {
          "$ref": "#/components/schemas/PongMessage"
        }
      },
      "room_chat_message": {
        "payload": {
          "$ref": "#/components/schemas/RoomChatMessage"
        }
      },
      "room_notification_message": {
        "payload": {
          "$ref": "#/components/schemas/RoomNotificationMessage"
        }
      }
    },
    "schemas": {
      "PingMessage": {
        "description": "Simple ping message to check WebSocket connection status.",
        "properties": {
          "action": {
            "const": "ping",
            "default": "ping",
            "title": "Action",
            "type": "string"
          },
          "payload": {
            "default": null,
            "title": "Payload",
            "type": "null"
          }
        },
        "title": "PingMessage",
        "type": "object"
      },
      "PongMessage": {
        "description": "Simple pong message response to ping requests.",
        "properties": {
          "action": {
            "const": "pong",
            "default": "pong",
            "title": "Action",
            "type": "string"
          },
          "payload": {
            "default": null,
            "title": "Payload",
            "type": "null"
          }
        },
        "title": "PongMessage",
        "type": "object"
      },
      "RoomChatMessage": {
        "description": "A chat message a client sends to its room.",
        "properties": {
          "action": {
            "const": "room_chat",
            "default": "room_chat",
            "title": "Action",
            "type": "string"
          },
          "payload": {
            "$ref": "#/components/schemas/RoomMessagePayload"
          }
        },
        "required": [
          "payload"
        ],
        "title": "RoomChatMessage",
        "type": "object"
      },
      "RoomMessagePayload": {
        "properties": {
          "message": {
            "title": "Message",
            "type": "string"
          },
          "room_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Room Name"
          }
        },
        "required": [
          "message"
        ],
        "title": "RoomMessagePayload",
        "type": "object"
      },
      "RoomNotificationMessage": {
        "description": "A chat message broadcast to everyone in the room.",
        "properties": {
          "action": {
            "const": "room_notification",
            "default": "room_notification",
            "title": "Action",
            "type": "string"
          },
          "payload": {
            "$ref": "#/components/schemas/RoomMessagePayload"
          }
        },
        "required": [
          "payload"
        ],
        "title": "RoomNotificationMessage",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Generated by chanx from the typed handlers in app/consumer.py",
    "title": "Room chat API",
    "version": "1.0.0"
  },
  "operations": {
    "handle_ping": {
      "action": "receive",
      "channel": {
        "$ref": "#/channels/room_chat"
      },
      "description": "",
      "messages": [
        {
          "$ref": "#/channels/room_chat/messages/ping_message"
        }
      ],
      "reply": {
        "channel": {
          "$ref": "#/channels/room_chat"
        },
        "messages": [
          {
            "$ref": "#/channels/room_chat/messages/pong_message"
          }
        ]
      },
      "summary": "Check the connection"
    },
    "handle_room_chat": {
      "action": "receive",
      "channel": {
        "$ref": "#/channels/room_chat"
      },
      "description": "",
      "messages": [
        {
          "$ref": "#/channels/room_chat/messages/room_chat_message"
        }
      ],
      "reply": {
        "channel": {
          "$ref": "#/channels/room_chat"
        },
        "messages": [
          {
            "$ref": "#/channels/room_chat/messages/room_notification_message"
          }
        ]
      },
      "summary": "Send a message to the room"
    }
  },
  "servers": {
    "development": {
      "host": "localhost:8000",
      "protocol": "ws"
    }
  }
}
